    {
      "name": "Annonces — CRUD",
      "item": [
        {
          "name": "5 - GET annonces (public, sans token) → 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Page content', () => pm.expect(pm.response.json().content).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/annonces?page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "annonces"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "6 - CREATE annonce (avec token) → 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.expect([200, 201]).to.include(pm.response.code));",
                  "const json = pm.response.json();",
                  "pm.test('Status DRAFT', () => pm.expect(json.status).to.eql('DRAFT'));",
                  "pm.collectionVariables.set('annonceId', json.id);",
                  "pm.collectionVariables.set('version', json.version || 0);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Appartement T3 lumineux\",\n  \"description\": \"Bel appartement au centre-ville\",\n  \"adress\": \"12 rue de la Paix, Paris\",\n  \"mail\": \"contact@example.com\",\n  \"categoryId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/annonces",
              "host": ["{{baseUrl}}"],
              "path": ["api", "annonces"]
            }
          }
        },
        {
          "name": "7 - GET annonce par ID → 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('ID correct', () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('annonceId'))));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/annonces/{{annonceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "annonces", "{{annonceId}}"]
            }
          }
        },
        {
          "name": "8 - UPDATE annonce (PUT) → 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Titre MAJ', () => pm.expect(pm.response.json().title).to.eql('Appartement T4 rénové'));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('version', json.version || 0);"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Appartement T4 rénové\",\n  \"description\": \"Bel appartement rénové récemment\",\n  \"adress\": \"15 avenue des Champs, Paris\",\n  \"mail\": \"nouveau@example.com\",\n  \"categoryId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/annonces/{{annonceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "annonces", "{{annonceId}}"]
            }
          }
        },
        {
          "name": "9 - PATCH status → PUBLISHED",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Statut PUBLISHED', () => pm.expect(pm.response.json().status).to.eql('PUBLISHED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PUBLISHED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/annonces/{{annonceId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "annonces", "{{annonceId}}", "status"]
            }
          }
        },
        {
          "name": "10 - PATCH status → ARCHIVED (admin only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Statut ARCHIVED', () => pm.expect(pm.response.json().status).to.eql('ARCHIVED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ARCHIVED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/annonces/{{annonceId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "annonces", "{{annonceId}}", "status"]
            }
          }
        },
