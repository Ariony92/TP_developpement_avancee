          "name": "POST /api/login — succès",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Contient un token', function () {",
                  "  pm.expect(json.token).to.be.a('string');",
                  "  pm.expect(json.token.length).to.be.above(10);",
                  "});",
                  "pm.test('Contient tokenType Bearer', function () {",
                  "  pm.expect(json.tokenType).to.eql('Bearer');",
                  "});",
                  "pm.test('Contient expiresIn', function () {",
                  "  pm.expect(json.expiresIn).to.be.above(0);",
                  "});",
                  "pm.environment.set('token', json.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
