{
  "info": {
    "_postman_id": "b9f7e5e2-9a7b-4b3e-9f7e-123456789abc",
    "name": "TP3 MasterAnnonce API (CORRIGÉ)",
    "description": "Collection Postman corrigée pour tester l'API (login + token + annonces + archive avant delete). Utilise des variables d'Environment: baseUrl, token, annonceId, version.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 - LOGIN (stocke token dans Environment)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.environment.set('token', json.token);",
              "// optionnel: nettoyer des variables si tu relances un scénario",
              "// pm.environment.unset('annonceId');",
              "// pm.environment.unset('version');"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"alice\",\n  \"password\": \"secret\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/login",
          "host": [ "{{baseUrl}}" ],
          "path": [ "api", "login" ]
        }
      },
      "response": []
    },
    {
      "name": "2 - GET annonces (SANS TOKEN) -> doit faire 401",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 401', function () {",
              "  pm.response.to.have.status(401);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/annonces",
          "host": [ "{{baseUrl}}" ],
          "path": [ "api", "annonces" ]
        }
      },
      "response": []
    },
    {
      "name": "3 - GET annonces (AVEC TOKEN) -> doit faire 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/annonces?page=0&size=10",
          "host": [ "{{baseUrl}}" ],
          "path": [ "api", "annonces" ],
          "query": [
            { "key": "page", "value": "0" },
            { "key": "size", "value": "10" }
          ]
        }
      },
      "response": []
    },
    {
      "name": "4 - CREATE annonce (AVEC TOKEN) -> stocke annonceId + version",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 ou 201', function () {",
              "  pm.expect([200, 201]).to.include(pm.response.code);",
              "});",
              "const json = pm.response.json();",
              "pm.environment.set('annonceId', json.id);",
              "pm.environment.set('version', (json.version !== undefined && json.version !== null) ? json.version : 0);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Annonce test\",\n  \"description\": \"Description test\",\n  \"adress\": \"Paris\",\n  \"mail\": \"test@test.com\",\n  \"categoryId\": 1,\n  \"authorId\": 2,\n  \"version\": 0\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/annonces",
          "host": [ "{{baseUrl}}" ],
          "path": [ "api", "annonces" ]
        }
      },
      "response": []
    },
    {
      "name": "5 - PATCH status -> ARCHIVED (obligatoire avant DELETE)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 ou 204', function () {",
              "  pm.expect([200, 204]).to.include(pm.response.code);",
              "});",
              "// Si l'API renvoie l'annonce, on peut MAJ la version",
              "try {",
              "  const json = pm.response.json();",
              "  if (json && json.version !== undefined && json.version !== null) {",
              "    pm.environment.set('version', json.version);",
              "  }",
              "} catch (e) {",
              "  // rien",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"ARCHIVED\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/annonces/{{annonceId}}/status",
          "host": [ "{{baseUrl}}" ],
          "path": [ "api", "annonces", "{{annonceId}}", "status" ]
        }
      },
      "response": []
    },
    {
      "name": "6 - DELETE annonce (AVEC TOKEN) -> utilise annonceId",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 ou 204', function () {",
              "  pm.expect([200, 204]).to.include(pm.response.code);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/annonces/{{annonceId}}",
          "host": [ "{{baseUrl}}" ],
          "path": [ "api", "annonces", "{{annonceId}}" ]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/dev_avancee_war"
    }
  ]
}
